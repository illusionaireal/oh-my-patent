{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","figure_id","purpose","main_sections","parts","connections","required_features","forbidden_structures","layout_constraints","language","backend","formats","review_criteria","optional"],
  "properties": {
    "schema_version": {"const":1},
    "figure_id": {"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"},
    "purpose": {"type":"string","minLength":1},
    "main_sections": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "parts": {"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,"required":["id","number","label"],"properties":{"id":{"type":"string","pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,79}$"},"number":{"type":"string","pattern":"^[0-9]+[a-z]?$"},"label":{"type":"string","minLength":1}}}},
    "connections": {"type":"array","maxItems":4000,"items":{"type":"object","additionalProperties":false,"required":["from","to","label"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"label":{"type":"string"}}}},
    "required_features": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "forbidden_structures": {"type":"array","items":{"type":"string","minLength":1}},
    "layout_constraints": {"type":"array","items":{"type":"string","minLength":1}},
    "language": {"enum":["en","zh"]},
    "backend": {"enum":["svg","imagegen","mermaid","plantuml"]},
    "formats": {"type":"array","minItems":1,"items":{"enum":["svg","png","jpg","webp"]}},
    "review_criteria": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "optional": {"type":"boolean"}
  }
}
