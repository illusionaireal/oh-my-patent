{
  "name": "oh-my-patent",
  "version": "0.3.1",
  "description": "Archimedes, your Eureka-to-patent guide. An AI patent plugin for Claude Code, Codex, and OpenCode that turns technical ideas into patent disclosures with traceable, forkable decision paths.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "oh-my-patent": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npx tsc --noEmit"
  },
  "keywords": [
    "patent",
    "patent-disclosure",
    "ai-agents",
    "archimedes",
    "claude-code",
    "codex",
    "opencode",
    "plugin",
    "brainstorm",
    "cli"
  ],
  "author": "oh-my-patent contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/illusionaireal/oh-my-patent.git"
  },
  "homepage": "https://github.com/illusionaireal/oh-my-patent#readme",
  "bugs": {
    "url": "https://github.com/illusionaireal/oh-my-patent/issues"
  },
  "files": [
    "dist/",
    "src/",
    "plugin.jsonc",
    "opencode.jsonc",
    "assets/brand/png/",
    "assets/brand/README.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "ink": "^7.0.2",
    "react": "^19.2.6"
  }
}
